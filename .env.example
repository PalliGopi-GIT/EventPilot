# =============================================================================
# EventPilot - Agentic Event Automation Platform
# Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit actual secrets to GitHub!

# -----------------------------------------------------------------------------
# AI - TokenRouter / GLM Configuration
# -----------------------------------------------------------------------------
AI_PROVIDER=tokenrouter
# Your TokenRouter API Key for GLM-4 or other supported models
AI_API_KEY=
# Base URL for API calls (defaults to https://api.tokenrouter.io/v1 if empty)
AI_BASE_URL=
# Model name (defaults to glm-4-plus if empty)
AI_MODEL=

# -----------------------------------------------------------------------------
# Database - PostgreSQL via Supabase
# -----------------------------------------------------------------------------
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# NextAuth / Security
# -----------------------------------------------------------------------------
# Generate a secure random string: `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Public URL of your deployed app (e.g., https://eventpilot.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use a separate long random string for AES-256-GCM encryption (fallback to NEXTAUTH_SECRET)
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Google OAuth 2.0 - Google Cloud Console Setup
# -----------------------------------------------------------------------------
# Create a project in Google Cloud Console:
# 1. Enable Google Forms API and Google People API
# 2. Configure OAuth Consent Screen (User Type: External, add test users)
# 3. Create OAuth 2.0 Client ID credentials
# The callback URL (must match Google Console): https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The callback URL (must match Google Console): https://your-domain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# -----------------------------------------------------------------------------
# Email - Resend
# -----------------------------------------------------------------------------
# Resend API key for sending generated form links (test account: onboarding@resend.dev)
RESEND_API_KEY=

# =============================================================================
# HACKATHON DEMO ACCOUNTS PRE-REGISTERED IN GOOGLE OAUTH
# =============================================================================
# In Google Cloud Console OAuth Consent Screen -> Test Users:
# - Add demo accounts (e.g., organizer@demo.com) to bypass unverified app warnings.
# - Without test users, the "Google hasn't verified this app" warning appears.